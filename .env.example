# Example environment variables for the Assessment project
# Copy this file to `.env` and replace the placeholders with your actual values

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Application port
PORT=3000

# JWT secret for authentication
JWT_SECRET="your_jwt_secret"

# Optional: Prisma client log level (adjust if needed)
PRISMA_LOG_LEVEL="query"
