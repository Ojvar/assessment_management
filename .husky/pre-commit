echo "🚀 Running NestJS pre-commit checks..."

# Stop if any command fails
set -e

# Detect Bun or fallback to npm/npx
if command -v bun >/dev/null 2>&1; then
  PKG_MGR="bun"
  RUN="bun run"
  EXEC="bunx"
  echo "💨 Using Bun"
else
  PKG_MGR="npm"
  RUN="npm run"
  EXEC="npx"
  echo "📦 Using npm"
fi

# 1️⃣ Lint the project
echo "🔍 Linting code..."
$RUN lint

# 4️⃣ Run Jest tests
echo "🧪 Running tests..."
$RUN test -- --passWithNoTests --bail --silent

echo "✅ All pre-commit checks passed successfully!"
