generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?

  @@map("users")
}

model Assessment {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  province    String
  city        String
  address     String
  zipCode     String
}

